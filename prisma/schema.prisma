
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


model ApplicationInfo {
  std_application_id                      String                    @id
  std_application                         StudentApplication        @relation(fields: [std_application_id], references: [std_application_id])
  
  std_info_prefix                         String?
  std_info_first_name                     String?
  std_info_last_name                      String?
  std_info_nick_name                      String?
  std_info_age                            Int?
  std_info_birthdate                      String?
  std_info_gender                         String?
  std_info_religion                       String?
  std_info_phone_number                   String?
  std_info_education_level                String?
  std_info_education_institute            String?
  std_info_education_plan                 String?
  std_info_parent_fullname                String?
  std_info_parent_relation                String?
  std_info_parent_phone_number            String?
  std_info_have_participated              Boolean?
  std_info_have_laptop                    Boolean?
  std_info_can_participate_every_day      Boolean?
  std_info_medical_insurance              String?
  std_info_chronic_disease                String?
  std_info_drug_allergy                   String?
  std_info_food_allergy                   String?
  std_info_blood_group                    String?
  std_info_address                        String?
  std_info_shirt_size                     String?
  std_info_travel_plan                    String?
  std_info_laptop_os                      String?
  std_info_have_tablet                    Boolean?
  std_info_have_mouse                     Boolean?
  created_at                              DateTime                  @default(now())
  updated_at                              DateTime                  @updatedAt
}

enum FileType {
  file_face
  file_national_id
  file_parent_permission
  file_pp_1
  file_pp_7
  file_slip
}

model ApplicationFile {
  std_application_id                      String                    
  std_application                         StudentApplication        @relation(fields: [std_application_id], references: [std_application_id])
  
  std_file_originalname                   String?
  std_file_mimetype                       String?
  std_file_encoding                       String?
  std_file_size                           Int?
  std_file_key                            String                    @id
  std_file_type                           FileType
  
  std_file_disabled                       Boolean                   @default(false)

  created_at                              DateTime                  @default(now())
  updated_at                              DateTime                  @updatedAt
}

model ApplicationRegisQuestionScore {
  id                                      Int                         @id @default(autoincrement())

  std_regis_answer_id                     Int                        
  std_regis_answer                        ApplicationRegisQuestionAnswer  @relation(fields: [std_regis_answer_id], references: [std_regis_answer_id])
  
  stf_count                               Int                         @db.Integer()
  stf_score                               Float
  stf_comment                             String?                     @db.Text

  stf_user_id                             String
  stf_user                                User                        @relation(fields: [stf_user_id], references: [id])

  created_at                              DateTime                    @default(now())
  updated_at                              DateTime                    @updatedAt
}

model ApplicationRegisQuestionAnswer {
  std_application_id                      String                    
  std_application                         StudentApplication        @relation(fields: [std_application_id], references: [std_application_id])
  
  std_regis_answer_id                     Int                       @id @default(autoincrement())
  std_regis_answer_section                String                    
  std_regis_answer                        String                    @db.Text

  stf_regis_question_score                ApplicationRegisQuestionScore[]
  
  created_at                              DateTime                  @default(now())
  updated_at                              DateTime                  @updatedAt
}

model ApplicationAcademicQuestionScore {
  id                                      Int                           @id @default(autoincrement())

  std_academic_answer_id                  Int                           
  std_academic_answer                     ApplicationAcademicQuestionAnswer @relation(fields: [std_academic_answer_id], references: [std_academic_answer_id])

  stf_count                               Int                           @db.Integer()
  stf_score                               Float

  stf_user_id                             String
  stf_user                                User                          @relation(fields: [stf_user_id], references: [id])

  created_at                              DateTime                       @default(now())
  updated_at                              DateTime                      @updatedAt
}

model ApplicationAcademicQuestionAnswer {
  std_application_id                      String                    
  std_application                         StudentApplication        @relation(fields: [std_application_id], references: [std_application_id])
  
  std_academic_answer_id                  Int                       @id @default(autoincrement())
  std_academic_answer_section             String
  std_academic_answer                     String

  stf_academic_question_score             ApplicationAcademicQuestionScore[]

  created_at                              DateTime                  @default(now())
  updated_at                              DateTime                  @updatedAt
}

