// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
}


datasource db {
  provider = "postgresql"
}


model Test {
  id              Int         @id @default(autoincrement())
  user_name       String      
  user_pass       String
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
}